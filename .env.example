# Defaults to fixture. Do not enable live mode without a new owner-approved budget.
# Values must be exported into the API process; .env is not automatically loaded.
LEARNSPRINT_ASSESSMENT_MODE=fixture
# Live mode additionally requires all of these server-only variables:
# LEARNSPRINT_LIVE_APPROVED=yes
# LEARNSPRINT_APPROVAL_BATCH=<new-owner-approved-batch-id>
# LEARNSPRINT_MAX_INVOCATIONS=<approved-call-count>
# LEARNSPRINT_BUDGET_USD=<approved-reservation-budget>
# LEARNSPRINT_RESERVE_PER_CALL_USD=<conservative-reservation-per-attempt>
# AWS_PROFILE=<local-profile-name>
# Region/model are fixed in code. Never use VITE_ variables for AWS credentials.
